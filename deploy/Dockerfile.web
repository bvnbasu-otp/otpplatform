# =============================================================================
# OTP Platform — Multi-Stage Production Dockerfile for Web Application
# =============================================================================

# --- Stage 1: Build Workspace ---
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

# Copy root manifest and workspace configuration
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all package manifests
COPY packages/domain/package.json ./packages/domain/
COPY packages/services/package.json ./packages/services/
COPY packages/database/package.json ./packages/database/
COPY packages/config/package.json ./packages/config/
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy full source trees
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/
COPY tsconfig.json ./

# Build packages and web app
RUN pnpm -r build

# --- Stage 2: Production Ingress Nginx ---
FROM nginxinc/nginx-unprivileged:alpine-slim AS runner

# Remove default nginx static assets and config
USER root
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/*

# Copy compiled SPA bundle from builder
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy production Nginx server configuration
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Set permissions for unprivileged execution
RUN chown -R 101:101 /usr/share/nginx/html && chmod -R 755 /usr/share/nginx/html

USER 101

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:80/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
