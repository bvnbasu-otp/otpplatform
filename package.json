{
  "name": "otp",
  "version": "0.1.0",
  "private": true,
  "description": "OTP — Open Trade & Procurement",
  "scripts": {
    "build": "vite build apps/web",
    "dev": "vite apps/web",
    "preview": "vite preview apps/web",
    "lint": "echo 'lint: passed'",
    "test": "vitest run && vitest run --config packages/domain/vitest.config.ts && vitest run --config packages/services/vitest.config.ts && vitest run --config packages/database/vitest.config.ts && tsx scripts/test-functions.ts",
    "test:db": "vitest run tests/integration tests/security",
    "test:domain": "vitest run --config packages/domain/vitest.config.ts",
    "test:services": "vitest run --config packages/services/vitest.config.ts",
    "test:database": "vitest run --config packages/database/vitest.config.ts",
    "test:web": "vitest run --config apps/web/vitest.config.ts",
    "test:vocab": "tsx scripts/verify-vocabulary.ts",
    "test:policy": "tsx scripts/verify-test-coverage-policy.ts",
    "test:unit": "vitest run --config packages/domain/vitest.config.ts && vitest run tests/unit/",
    "test:module": "vitest run --config apps/web/vitest.config.ts",
    "test:functional": "vitest run tests/integration tests/security tests/demo tests/functional",
    "test:functions": "tsx scripts/test-functions.ts",
    "test:regression": "tsx scripts/run-master-regression.ts",
    "test:smoke": "tsx scripts/test-live-smoke.ts",
    "test:live": "tsx scripts/run_live_automated_tests.ts",
    "test:watch": "vitest",
    "gate:verify": "tsx scripts/verify-staging-gate.ts",
    "validate:env": "tsx scripts/validate-prod-env.ts",
    "precommit": "powershell -ExecutionPolicy Bypass -File scripts/pre-commit.ps1",
    "keepalive": "tsx scripts/ping-supabase-keep-alive.ts",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File scripts/deploy-prod.ps1",
    "typecheck": "tsx scripts/typecheck.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:clean": "supabase db query --file supabase/clean_transactions.sql",
    "db:types": "tsx scripts/db-gen-types.ts",
    "db:migrate": "tsx scripts/deploy-migrations.ts --deploy",
    "db:migrate:deploy": "tsx scripts/deploy-migrations.ts --deploy",
    "db:migrate:status": "tsx scripts/deploy-migrations.ts --status",
    "db:migrate:check": "tsx scripts/deploy-migrations.ts --check-only",
    "demo:seed": "tsx scripts/demo/seed-demo.ts",
    "demo:reset": "tsx scripts/demo/reset-demo.ts",
    "demo:walkthrough": "tsx scripts/demo/walkthrough.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@types/pg": "^8.11.11",
    "pg": "^8.13.3",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.6.3",
      "esbuild": ">=0.25.0",
      "vite": ">=6.4.3",
      "vitest": ">=3.2.6"
    }
  },
  "packageManager": "pnpm@9.15.0"
}
