# Local development. Production builds must override every variable below;
# see docs/DEPLOYMENT.md. The web bundle refuses to build when any of these is
# missing at build time.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-key-from-your-disposable-local-project
VITE_DEMO_MODE=true

# Optional: point at a Sentry DSN to receive client errors. When unset the app
# logs to the console.
# VITE_SENTRY_DSN=
