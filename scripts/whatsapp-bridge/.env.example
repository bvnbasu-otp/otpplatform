# Variable names read by scripts/whatsapp-bridge/index.js. Values are never
# committed. The bridge reads the process environment first, then the
# repository-root .env.otp.production.local (git-ignored).

# Existing WhatsApp proxy
WAHA_API_KEY=
WAHA_TARGET_URL=
BRIDGE_HOST=
BRIDGE_PORT=

# Contact Us email relay (POST /contact-email). The relay stays disabled until
# the secret (32+ characters, different from WAHA_API_KEY) and SMTP settings exist.
CONTACT_EMAIL_RELAY_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_SENDER_NAME=
